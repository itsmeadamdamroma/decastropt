{
  "name": "get-services",
  "type": "info",
  "description": "Retrieve the list of personal training services offered by Decastro PT.",
  "outputSchema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" }
      }
    }
  },
  "execute": {
    "method": "GET",
    "url": "https://decastropt.com/api/services"
  }
}
